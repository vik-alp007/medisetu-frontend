# Copy to .env (or set in your hosting dashboard) - all optional.

# Backend base URL (defaults to the deployed Render backend)
VITE_API_BASE_URL=https://hospital-management-system-ccc.onrender.com

# Doctor/Admin dashboards: when the dashboard endpoint is unavailable,
# fall back to clearly-labelled DEMO data (src/data/mockDashboards.js).
# Set to "false" in production to show a real error state instead.
VITE_ENABLE_DEMO_FALLBACK=true

# Medical report upload: set to "true" ONLY after the backend confirms the
# upload contract (see src/services/reportService.js).
VITE_REPORT_UPLOAD_ENABLED=false

# ML service: set to "true" ONLY after the ML team provides the real API
# (see src/services/mlService.js + mlAdapter.js). Never put private ML keys here.
VITE_ML_ENABLED=false
